{
  "name": "dubai-run-territory",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @dubai-run/web dev",
    "build": "pnpm --filter @dubai-run/core typecheck && pnpm --filter @dubai-run/web build",
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "zone:cells": "tsx scripts/create-zone.ts",
    "fixtures": "tsx scripts/make-fixture.ts",
    "seed:sql": "tsx scripts/generate-seed.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:types": "supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public | prettier --parser typescript > supabase/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@garmin/fitsdk": "21.218.0",
    "@types/node": "^20.19.24",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "h3-js": "4.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
